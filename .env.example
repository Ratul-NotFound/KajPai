# ========================================================
# JobPulse BD Environment Configuration
# ========================================================

# 1. Supabase PostgreSQL (Free tier - https://supabase.com)
# Create a free project on Supabase and copy the URL and Keys from Project Settings > API:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. Telegram Bot Notifications (Optional - 100% Free)
# Create a bot via @BotFather on Telegram to get your token.
# Get your Chat ID by messaging @userinfobot on Telegram.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=987654321

